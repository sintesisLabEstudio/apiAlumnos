<?xml version="1.0" encoding="utf-8"?>
<!-- Layout para listar asignaturas y, en modo edicion, modificar la seleccionada. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp">
    <!-- Barra superior con boton para volver al menu. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⌂" />
    </LinearLayout>
    <!-- Titulo dinamico segun modo listado o edicion. -->
    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Listado de asignaturas" />
    <!-- Lista de asignaturas obtenidas desde la API. -->
    <ListView
        android:id="@+id/lvAsignaturas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <!-- Campos de edicion visibles solo en modo edicion. -->
    <TextView
        android:id="@+id/tvId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Id: -" />
    <EditText
        android:id="@+id/etNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre de la asignatura"
        android:inputType="textCapSentences" />
    <!-- Botones de edicion, actualizacion y mensaje de estado. -->
    <Button
        android:id="@+id/btnEditarAsignatura"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Editar asignatura" />
    <Button
        android:id="@+id/btnActualizar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Actualizar lista" />
    <TextView
        android:id="@+id/tvResultado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />
</LinearLayout>